# Production settings (docker-compose.yml reads these from .env)
PORT=3000
MONGO_DB=smartcampus
# Public URL users type in the browser. Must match exactly (used for the Origin check).
APP_URL=http://localhost:3000
# Other origins the console may be opened from, comma separated (e.g. the machine's LAN address).
ALLOWED_ORIGINS=
# Set both to true when running behind an HTTPS reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
# Hard session limit, and sign-out after this much inactivity
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=30
# Password sign-in attempts per address per 15 minutes.
LOGIN_RATE_LIMIT=10

# Two-factor authentication. TWO_FACTOR_KEY encrypts the authenticator secrets (32 random bytes, base64: openssl rand -base64 32).
# It is a secret: required in production, never committed. Administrators must set up two-factor before using the console.
TWO_FACTOR_KEY=
TWO_FACTOR_ISSUER=Smart Campus
REQUIRE_ADMIN_2FA=true

# Seconds a device may stay offline before administrators and operators get an alert (0 = no alert).
DEVICE_OFFLINE_ALERT_SECONDS=120

# Outgoing mail for password resets and invitations. Without SMTP_HOST, mails are only logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=SmartCampus <no-reply@your-domain>

# First admin, created on startup if missing. Remove the password afterwards.
SEED_ADMIN_EMAIL=admin@example.com
# At least 10 characters
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Device gateway. The key is a mounted secret (see docker-compose.yml), never part of the repo.
ENROLL_REQUEST_TTL_MINUTES=15
ENROLL_RATE_LIMIT=20
ENROLL_STATUS_RATE_LIMIT=120
GATEWAY_CONNECTS_PER_MINUTE=30
MAX_PENDING_ENROLLMENTS=50

# Largest audio file accepted for broadcasts, in megabytes.
MAX_AUDIO_MB=10

# Largest image or video accepted for the Faculty screens' custom content, in megabytes.
MAX_MEDIA_MB=50

# Campus time zone, used by schedules and reservations.
CAMPUS_TIMEZONE=Europe/Paris

# Text-to-speech for voice announcements: any server speaking the OpenAI /audio/speech API.
# Leave TTS_URL empty to switch the voice features off. Voices are `id|label|language`, comma separated (a label cannot contain a comma).
TTS_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_VOICES=alloy|Alloy|en,nova|Nova|fr
# Voice that reads emergencies aloud (an id from TTS_VOICES, ideally a serious male voice) and its pace (0.5 to 1.5, 1 is natural).
TTS_EMERGENCY_VOICE=
TTS_EMERGENCY_SPEED=0.9
TTS_TIMEOUT_MS=30000

# Microsoft Azure / Entra ID SSO (scaffold, not functional yet)
AZURE_ENABLED=false
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=
AZURE_AUTO_PROVISION=false
